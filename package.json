{
  "name": "jijibao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:check": "wrangler deploy -c worker/wrangler.toml --dry-run",
