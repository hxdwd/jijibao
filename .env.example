# Supabase 项目配置
# 推荐用相对路径 /api/supabase：由同域 Worker 反代到 Supabase，
# 浏览器不直连 *.supabase.co（国内可达性差），只连 Pages 域名。
VITE_SUPABASE_URL=/api/supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# Worker 里 SUPABASE_ORIGIN 需指向真实项目地址（worker/src/index.ts）
# 如：https://<project-ref>.supabase.co

# 本地开发时指向 wrangler pages dev 地址（如 http://127.0.0.1:8788）
# 生产环境留空，走同源 /api
VITE_FUNCTIONS_URL=
